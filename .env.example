# GrowPath AI - Environment Variables Template
# Copy this file to .env and configure your keys

# 1. Google Gemini API Key (Required for AI Resume Optimizer, Interview Prep & Learning Roadmap)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. JSearch API Key via RapidAPI (Required for Live Job Search Engine)
# https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Deprecated / No longer required:
# THEIRSTACK_API_KEY=

